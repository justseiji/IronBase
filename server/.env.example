# Copy this file to .env and fill in real values for your machine.
# .env itself is gitignored — never commit it.

DATABASE_URL=postgres://example_user:example_password@localhost:5432/ironbase
PORT=3001
# COOKIE_SECURE=true
# TRUST_PROXY=1
# CORS_ORIGIN=https://app.example.com

# Password reset emails (Gmail account + app password). Leave unset in local
# development and the reset link is printed to the server console instead.
# GMAIL_USER=ironbase.app@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop
# Public address of the web app, used to build reset links.
# APP_URL=https://app.example.com
