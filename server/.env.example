# Copy this file to .env and fill in real values for your machine.
# .env itself is gitignored — never commit it.

DATABASE_URL=postgres://example_user:example_password@localhost:5432/ironbase
PORT=3001
# COOKIE_SECURE=true
# TRUST_PROXY=1
# CORS_ORIGIN=https://app.example.com

# Password reset emails, sent through the Gmail API. Leave unset in local
# development and the reset link is printed to the server console instead.
# The client ID/secret come from a Google Cloud OAuth client; run
# `npm run gmail-auth` to sign in as GMAIL_USER and get the refresh token.
# GMAIL_USER=ironbase.app@gmail.com
# GMAIL_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-example
# GMAIL_REFRESH_TOKEN=1//example
# Public address of the web app, used to build reset links.
# APP_URL=https://app.example.com
